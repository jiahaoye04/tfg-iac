# Configuración Homer gestionada por Ansible - NO editar manualmente
title: "Homelab TFG - Jiahao"
subtitle: "Infraestructura IaC"
header: true
footer: false

colors:
  light:
    highlight-primary: "#3367d6"
    background: "#f5f5f5"
  dark:
    highlight-primary: "#3367d6"
    background: "#131313"

services:
  - name: "Servicios"
    items:
{% for svc in homer_services %}
      - name: "{{ svc.name }}"
        subtitle: "{{ svc.subtitle }}"
        logo: "{{ svc.logo }}"
        url: "{{ svc.url }}"
        target: "_blank"
{% endfor %}
