#!/bin/bash
set -euo pipefail
BACKUP_DIR="{{ pg_backup_dir }}"
KEEP={{ pg_backup_keep }}
TS=$(date +%F_%H-%M-%S)
mkdir -p "$BACKUP_DIR"
# Volcado lógico completo (todas las BD + roles/contraseñas), comprimido
pg_dumpall | gzip > "$BACKUP_DIR/pg_dumpall-$TS.sql.gz"
# Rotación: conservar solo los últimos $KEEP
ls -1t "$BACKUP_DIR"/pg_dumpall-*.sql.gz | tail -n +$((KEEP + 1)) | xargs -r rm -f
